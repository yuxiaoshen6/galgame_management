<Window x:Class="GalgameManager.Desktop.ForumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="樱笺论坛" Width="1040" Height="720" MinWidth="740" MinHeight="530"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,15">
            <Button x:Name="NewTopicButton" DockPanel.Dock="Right" Content="发帖" Style="{StaticResource Primary}" Click="NewTopic"/>
            <TextBlock Text="论坛" FontSize="25" FontWeight="SemiBold"/>
        </DockPanel>
        <Grid x:Name="ForumContent" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="11">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                        <Button DockPanel.Dock="Right" Content="搜索" Click="Search" Padding="9,4" MinHeight="34" Margin="6,0,0,0"/>
                        <TextBox x:Name="SearchBox" MaxLength="120" AutomationProperties.Name="搜索帖子标题" KeyDown="SearchOnEnter"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
                        <Button x:Name="PreviousTopics" DockPanel.Dock="Left" Content="上一页" Click="PreviousTopicPage" IsEnabled="False" MinHeight="28" Padding="6,3"/>
                        <Button x:Name="NextTopics" DockPanel.Dock="Right" Content="下一页" Click="NextTopicPage" IsEnabled="False" MinHeight="28" Padding="6,3"/>
                        <TextBlock x:Name="TopicPageLabel" Style="{StaticResource Quiet}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="Topics" SelectionChanged="SelectTopic" AutomationProperties.Name="帖子列表"
                             Background="{StaticResource Field}" Foreground="{StaticResource Ink}" BorderBrush="{StaticResource Line}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="7,6,7,6">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Quiet}" Margin="0,2,0,0">
                                        <Run Text="{Binding Author, Mode=OneWay}"/><Run Text=" · "/>
                                        <Run Text="{Binding ReplyCount, Mode=OneWay}"/><Run Text=" 条回复"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="14"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <TextBlock x:Name="EmptyTopic" Text="选择一个帖子查看详情。" Style="{StaticResource Quiet}" Margin="3"/>
                    <DockPanel x:Name="TopicDetail" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="PreviousReplies" DockPanel.Dock="Left" Content="上一页回复" Click="PreviousReplyPage" IsEnabled="False" MinHeight="28" Padding="6,3"/>
                                <Button x:Name="NextReplies" DockPanel.Dock="Right" Content="下一页回复" Click="NextReplyPage" IsEnabled="False" MinHeight="28" Padding="6,3"/>
                                <TextBlock x:Name="ReplyPageLabel" Style="{StaticResource Quiet}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="ReplyBox" MaxLength="6000" MinHeight="55" MaxHeight="95" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="回复正文"/>
                            <Button Content="回复" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="SendReply" Margin="0,6,0,0" MinHeight="30"/>
                        </StackPanel>
                        <ScrollViewer x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="ThreadTitle" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ThreadAuthor" Style="{StaticResource Quiet}" Margin="0,5,0,10"/>
                                <TextBlock x:Name="ThreadBody" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                <TextBlock Text="回复" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ItemsControl x:Name="Replies">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Author}" Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
            <Border x:Name="Compose" Grid.Column="1" Margin="12,0,0,0" Padding="14" Visibility="Collapsed"
                    CornerRadius="9" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="新帖子" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,13"/>
                        <TextBlock Text="标题" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TitleBox" MaxLength="120" AutomationProperties.Name="帖子标题" Margin="0,0,0,12"/>
                        <TextBlock Text="正文" Style="{StaticResource FieldLabel}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,9,0,0" HorizontalAlignment="Right">
                        <Button Content="取消" Click="CancelTopic" Margin="0,0,8,0"/>
                        <Button Content="发布" Click="PublishTopic" Style="{StaticResource Primary}"/>
                    </StackPanel>
                    <TextBox x:Name="BodyBox" MaxLength="12000" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="帖子正文"/>
                </DockPanel>
            </Border>
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" Style="{StaticResource Quiet}" Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
