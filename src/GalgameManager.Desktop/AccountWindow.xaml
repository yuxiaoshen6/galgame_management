<Window x:Class="GalgameManager.Desktop.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="论坛账号" Width="450" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <StackPanel Margin="26">
        <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="登录后可浏览论坛、发帖和回复。" Style="{StaticResource Quiet}" Margin="0,7,0,18"/>
        <StackPanel x:Name="Fields">
            <TextBlock Text="邮箱" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="EmailBox" MaxLength="254" AutomationProperties.Name="邮箱" Margin="0,0,0,14"/>
            <StackPanel x:Name="NicknameField">
                <TextBlock Text="昵称" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NicknameBox" MaxLength="40" AutomationProperties.Name="昵称" Margin="0,0,0,14"/>
            </StackPanel>
            <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordInput" MaxLength="128" AutomationProperties.Name="密码"
                         Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Ink}"
                         Padding="9,5" MinHeight="33" Margin="0,0,0,14"/>
            <StackPanel x:Name="ConfirmationField">
                <TextBlock Text="确认密码" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="ConfirmInput" MaxLength="128" AutomationProperties.Name="确认密码"
                             Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" Foreground="{StaticResource Ink}"
                             Padding="9,5" MinHeight="33"/>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="Status" Foreground="{StaticResource Error}" TextWrapping="Wrap"
                   Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite"/>
        <DockPanel>
            <Button x:Name="SubmitButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsDefault="True" Click="Submit"/>
            <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="ModeButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="SwitchMode"/>
        </DockPanel>
    </StackPanel>
</Window>
